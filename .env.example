# GasGx AI Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git - it is listed in .gitignore for security

# Groq API Key (获取地址: https://console.groq.com)
GROQ_API_KEY=gsk_your_actual_key_here

# 投喂接口密码 (用于 /ai/feed 端点)
FEED_PASSWORD=your_secure_password_here

# 数据库路径 (可选，默认为 ./chroma_db_data)
DB_PATH=./chroma_db_data

# 日志文件路径 (可选，默认为 chat_history.log)
LOG_FILE=chat_history.log

# Supabase Edge Function: quote-translate
# Used by the quote real-page editor to auto-generate EN / RU from Chinese.
XFYUN_SPARK_URL=
XFYUN_SPARK_APP_ID=
XFYUN_SPARK_API_KEY=
XFYUN_SPARK_API_SECRET=
XFYUN_SPARK_DOMAIN=generalv3.5
XFYUN_SPARK_TEMPERATURE=0.2
XFYUN_SPARK_MAX_TOKENS=2048
XFYUN_SPARK_CHAT_SYSTEM_PROMPT=
