# GasGx AI Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git - it is listed in .gitignore for security

# Groq API Key (获取地址: https://console.groq.com)
GROQ_API_KEY=gsk_your_actual_key_here

# 投喂接口密码 (用于 /ai/feed 端点)
FEED_PASSWORD=your_secure_password_here

# 数据库路径 (可选，默认为 ./chroma_db_data)
DB_PATH=./chroma_db_data

# 日志文件路径 (可选，默认为 chat_history.log)
LOG_FILE=chat_history.log
