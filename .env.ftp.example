# FTP deployment config
# Copy to .env.ftp and fill in real values.
# .env.ftp is ignored by git.

FTP_HOST=47.77.201.76
FTP_PORT=21
FTP_USER=your_username
FTP_PASS=your_password

# Optional: base directory on remote FTP. Empty means FTP root.
FTP_BASE_DIR=

# Optional: 0 disables EPSV if your server/network has compatibility issues.
FTP_USE_EPSV=1
